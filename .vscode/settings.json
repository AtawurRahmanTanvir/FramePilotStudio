        "**/.git/refs/**": true,
        "**/__pycache__/**": true,
        "**/*.pyc": true,
        "**/node_modules/**": true,
        "runtime/motion/renderer/node_modules/**": true,
        "runtime/motion/node/**": true,
        "runtime/motion/browser/**": true,
        "runtime/motion/renderer/.bundle-cache/**": true,
        "runtime/backend/**": true,
        "runtime/ffmpeg/**": true,
        "runtime/models/**": true,
        "release/**": true,
        "backups/**": true,
        ".build-runtime-venv/**": true,
        ".pip-cache/**": true
    }
