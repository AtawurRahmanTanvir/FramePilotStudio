{
  "name": "framepilot-studio",
  "version": "0.1.4",
  "description": "Local-first video production workflow with Script-to-Image planning and Filmora automation",
  "main": "src/main/main.js",
  "author": "FramePilot Studio",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test:python": "python -m unittest discover -s tests -p \"test_*.py\"",
    "test:node": "node --test tests/*.test.js",
    "test": "npm run test:python && npm run test:node",
    "build:dir": "electron-builder --dir",
    "dist": "python tools/check_release_runtime.py && electron-builder --win appx",
    "build:backend": "pyinstaller --noconfirm --clean tools/FramePilotBackend.spec",
    "preflight": "python tools/check_release_runtime.py",
    "build:offline-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/BUILD_WINDOWS_OFFLINE_RUNTIME.ps1"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "studio.framepilot.desktop",
    "productName": "FramePilot Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime/backend",
        "to": "runtime/backend",
        "filter": [
          "FramePilotBackend/**/*"
        ]
      },
      {
        "from": "runtime/ffmpeg",
        "to": "runtime/ffmpeg",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/models",
        "to": "runtime/models",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/manifests/runtime-manifest.json",
        "to": "runtime/manifests/runtime-manifest.json"
      },
      {
        "from": "runtime/manifests/python-requirements-lock.txt",
        "to": "runtime/manifests/python-requirements-lock.txt"
      },
      {
        "from": "runtime/README_BN.md",
        "to": "runtime/README_BN.md"
      },
      {
        "from": "runtime/BUILD_WINDOWS_CPU_RUNTIME_BN.md",
        "to": "runtime/BUILD_WINDOWS_CPU_RUNTIME_BN.md"
      },
      {
        "from": "branding/framepilot-window.png",
        "to": "branding/framepilot-window.png"
      },
      {
        "from": "branding/framepilot-studio.ico",
        "to": "branding/framepilot-studio.ico"
      },
      {
        "from": "vendor/whisperx-source/LICENSE",
        "to": "licenses/whisperx-LICENSE"
      },
      "THIRD_PARTY_NOTICES.md",
      {
        "from": "Master_promt.txt",
        "to": "Master_promt.txt"
      }
    ],
    "win": {
      "icon": "branding/framepilot-studio.ico",
      "target": [
        {
          "target": "appx",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FramePilot-Studio-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "branding/framepilot-studio.ico",
      "uninstallerIcon": "branding/framepilot-studio.ico",
      "installerHeaderIcon": "branding/framepilot-studio.ico",
      "deleteAppDataOnUninstall": false
    },
    "appx": {
      "applicationId": "FramePilotStudio",
      "identityName": "AtawurRahman.FramePilotStudio",
      "publisher": "CN=75384DDE-01B9-4CD1-9B84-566EEBE74F94",
      "publisherDisplayName": "Atawur Rahman",
      "displayName": "FramePilot Studio",
      "languages": [
        "en-US"
      ]
    }
  }
}
